---
import { Menu } from "lucide-react";
import NotraBadge from "@/components/notra-badge.astro";
import { NAV_LINKS } from "@/constants/site";
---

<header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-6">
  <div class="flex min-w-0 items-center gap-2.5 whitespace-nowrap">
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" class="size-7" />
      Bias
    </a>
    <NotraBadge />
  </div>
  <nav class="text-muted-foreground hidden items-center gap-6 text-sm whitespace-nowrap md:flex">
    {NAV_LINKS.map((link) => <a href={link.href} class="hover:text-foreground">{link.label}</a>)}
  </nav>
  <button
    type="button"
    popovertarget="mobile-nav"
    aria-label="Open menu"
    class="text-muted-foreground hover:text-foreground hover:bg-muted -mr-2 flex size-10 shrink-0 items-center justify-center rounded-lg md:hidden"
  >
    <Menu className="size-5" aria-hidden="true" />
  </button>
  <nav
    id="mobile-nav"
    popover
    class="bg-background text-foreground inset-x-4 top-20 bottom-auto m-0 h-auto w-auto rounded-2xl border p-2 origin-top-right shadow-lg md:hidden"
  >
    {NAV_LINKS.map((link) => <a href={link.href} class="hover:bg-muted block rounded-lg px-4 py-3">{link.label}</a>)}
  </nav>
</header>

<script>
  const menu = document.getElementById("mobile-nav");
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.hidePopover()));
</script>

<style>
  #mobile-nav {
    opacity: 0;
    translate: 0 -0.5rem;
    scale: 0.97;
    transition:
      opacity 180ms ease-in-out,
      translate 180ms ease-in-out,
      scale 180ms ease-in-out,
      display 180ms allow-discrete,
      overlay 180ms allow-discrete;
  }

  #mobile-nav:popover-open {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  @starting-style {
    #mobile-nav:popover-open {
      opacity: 0;
      translate: 0 -0.5rem;
      scale: 0.97;
    }
  }

  #mobile-nav::backdrop {
    background-color: rgb(0 0 0 / 0);
    transition:
      background-color 180ms ease-in-out,
      display 180ms allow-discrete,
      overlay 180ms allow-discrete;
  }

  #mobile-nav:popover-open::backdrop {
    background-color: rgb(0 0 0 / 0.1);
  }

  @starting-style {
    #mobile-nav:popover-open::backdrop {
      background-color: rgb(0 0 0 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav,
    #mobile-nav::backdrop {
      transition: none;
    }
  }
</style>
