---
import { Code } from "astro:components";
import BiasDemo from "@/components/bias-demo";
import BiasExamples from "@/components/bias-examples";
import HeroActions from "@/components/hero-actions";
import ClaudeMention from "@/components/claude-mention.astro";
import ProviderLink from "@/components/provider-link.astro";
import SiteHeader from "@/components/site-header.astro";
import Layout from "@/layouts/Layout.astro";
import { trackedUrl } from "@/utils/url";
import {
  BIAS_EXAMPLE,
  CASES,
  EVALS_URL,
  GATEWAYS,
  INSTALL_COMMAND,
  MCP_CONFIG,
  NOTRA_URL,
  PROVIDERS,
  QUOTE,
  REPO_URL,
  SITE_DESCRIPTION,
  SITE_REPO_URL,
  SITE_TITLE,
  STEPS,
} from "@/constants/site";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <SiteHeader />

  <main>
    <section class="mx-auto max-w-3xl px-6 pt-16 pb-14 text-center sm:pt-24">
      <h1 class="text-4xl font-semibold tracking-[-0.03em] text-balance sm:text-6xl">
        Web search that tells your agent who is behind every page
      </h1>
      <p class="text-muted-foreground mx-auto mt-6 max-w-2xl text-lg text-pretty">
        Bias lets your agent search the web and warns it when a page comes from someone with a stake in the answer,
        like a company ranking its own product first. Each page gets a score from 0 to 1 and a short explanation.
      </p>
      <HeroActions />
      <div class="mt-14">
        <p class="text-muted-foreground text-sm">Works with your keys for</p>
        <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
          {
            PROVIDERS.map((provider) => (
              <li>
                <a href={trackedUrl(provider.url)} target="_blank" rel="noopener" class="block opacity-80 transition-opacity hover:opacity-100" aria-label={provider.name}>
                  <img src={provider.logo} alt={provider.name} width={provider.width} height={provider.height} class={`${provider.className} w-auto`} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-6 pb-24">
      <BiasDemo client:visible />
    </section>

    <section class="mx-auto max-w-3xl px-6 pb-24">
      <figure class="bg-muted/60 rounded-2xl border p-6 sm:p-8">
        <blockquote class="text-lg text-pretty">
          "{QUOTE.parts.map((part) => (part.link ? <ProviderLink name={part.link.name} url={part.link.url} domain={part.link.domain} track={part.link.track} /> : part.text))}"
        </blockquote>
        <figcaption class="text-muted-foreground mt-6 flex items-center gap-3 text-sm">
          <img src={QUOTE.author.avatar} alt={QUOTE.author.name} width="36" height="36" class="size-9 rounded-full" loading="lazy" />
          <span class="flex flex-col">
            <span class="text-foreground font-medium">{QUOTE.author.name}</span>
            <span>
              {QUOTE.author.role} <a href={trackedUrl(QUOTE.author.url)} target="_blank" rel="noopener" class="text-foreground underline underline-offset-4">{QUOTE.author.company}</a>
            </span>
          </span>
        </figcaption>
      </figure>
    </section>

    <section class="bg-muted/60 border-y">
      <div class="mx-auto grid max-w-5xl gap-12 px-6 py-24 lg:grid-cols-2 lg:items-start">
        <div>
          <h2 class="text-3xl font-semibold tracking-[-0.02em]">What a fetch returns</h2>
          <p class="text-muted-foreground mt-4 text-pretty">
            Scoring is on by default, so <code class="text-foreground">web_fetch</code> adds a <code class="text-foreground">bias</code> object next to the page markdown. The score runs from 0 for an independent source to 1 for a publisher
            with a direct stake in the conclusion it pushes. The reason names the publisher and the stake, and each
            entry in <code class="text-foreground">sources</code> points to the page or to a search result about the publisher.
          </p>
          <p class="text-muted-foreground mt-4 text-pretty">
            Pass <code class="text-foreground">bias: false</code> to skip the model call when you only need the content.
          </p>
          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {
              CASES.map((item) => (
                <div class="bg-background rounded-2xl border p-5 shadow-xs">
                  <h3 class="font-medium">{item.title}</h3>
                  <p class="text-muted-foreground mt-2 text-sm text-pretty">{item.body}</p>
                </div>
              ))
            }
          </div>
        </div>
        <div class="min-w-0 overflow-hidden rounded-2xl border bg-white text-[0.8125rem] shadow-xs [&_pre]:overflow-x-auto [&_pre]:p-5">
          <Code code={BIAS_EXAMPLE} lang="json" theme="github-light" wrap />
        </div>
      </div>
    </section>

    <section id="examples" class="mx-auto max-w-5xl scroll-mt-8 px-6 py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-semibold tracking-[-0.02em]">Examples from the evals</h2>
        <p class="text-muted-foreground mt-4 text-pretty">
          The repository ships an eval set of fictional pages, and each card below shows one of them with the score
          range the eval expects. Run <code class="text-foreground">pnpm eval</code> to score them with your own key,
          or read the cases <a href={EVALS_URL} class="text-foreground underline underline-offset-4">on GitHub</a>.
        </p>
      </div>
      <div class="mt-12">
        <BiasExamples client:visible />
      </div>
    </section>

    <section id="how" class="mx-auto max-w-5xl scroll-mt-8 px-6 py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <h2 class="text-3xl font-semibold tracking-[-0.02em]">How the score is made</h2>
          <p class="text-muted-foreground mt-4 text-pretty">
            <ClaudeMention /> reads each page and writes the score, and the server checks the sources it cites before
            the result reaches your agent. Scoring a 30,000 token article costs about $0.003.
          </p>
        </div>
        <ol class="space-y-6">
          {
            STEPS.map((step, index) => (
              <li class="flex gap-4">
                <span class="marketing-gradient-flat flex size-7 shrink-0 items-center justify-center rounded-full text-sm font-medium text-white">
                  {index + 1}
                </span>
                <p class="pt-0.5 text-pretty">{step}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bg-muted/60 border-y">
      <div class="mx-auto max-w-3xl px-6 py-24">
        <h2 class="text-3xl font-semibold tracking-[-0.02em]">One interface over three providers</h2>
        <p class="text-muted-foreground mt-4 text-pretty">
          Bias uses one provider at a time, picked from the keys you have set. It tries
          <ProviderLink name="Firecrawl" url="https://www.firecrawl.dev" domain="firecrawl.dev" /> first, then
          <ProviderLink name="Context.dev" url="https://www.context.dev" domain="context.dev" />, then
          <ProviderLink name="Exa" url="https://exa.ai" domain="exa.ai" />, and only moves to the next one when a call
          fails, so a single key is all you need.
        </p>
        <p class="text-muted-foreground mt-4 text-pretty">
          Both tools return the page as markdown in the same result shape, whichever provider answered. You can name a
          provider on any call, or pass several to <code class="text-foreground">web_search</code> to merge their
          results.
        </p>
      </div>
    </section>

    <section id="install" class="mx-auto max-w-3xl scroll-mt-8 px-6 py-24">
      <h2 class="text-3xl font-semibold tracking-[-0.02em]">Add it to your agent</h2>
      <p class="text-muted-foreground mt-4 text-pretty">
        Build the server, then add it to Claude Code, Claude Desktop or Cursor. You need one search provider key and
        one model gateway for scoring.
      </p>
      <div class="mt-8 space-y-4 text-[0.8125rem] [&_pre]:overflow-x-auto [&_pre]:rounded-2xl [&_pre]:border [&_pre]:p-5">
        <Code code={INSTALL_COMMAND} lang="bash" theme="github-light" />
        <Code code={MCP_CONFIG} lang="json" theme="github-light" />
      </div>
      <h3 class="mt-14 text-xl font-semibold tracking-[-0.01em]">Pick a model gateway</h3>
      <p class="text-muted-foreground mt-3 text-pretty">
        Scoring runs through the <a href={trackedUrl("https://ai-sdk.dev")} target="_blank" rel="noopener" class="text-foreground underline underline-offset-4">AI SDK</a>.
        Bias checks for these keys in order and uses the first gateway that is fully set. Every gateway defaults to
        <ClaudeMention />, and <code class="text-foreground">BIAS_MODEL</code> switches to another model.
      </p>
      <ol class="mt-6 space-y-3">
        {
          GATEWAYS.map((gateway, index) => (
            <li class="bg-muted/60 flex gap-4 rounded-2xl border p-5">
              <span class="text-muted-foreground w-4 shrink-0 pt-0.5 text-sm tabular-nums">{index + 1}</span>
              <div class="min-w-0">
                <ProviderLink name={gateway.name} url={gateway.url} domain={gateway.domain} />
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {gateway.env.map((name) => (
                    <code class="bg-background rounded-md border px-2 py-0.5 text-xs">{name}</code>
                  ))}
                </div>
                <p class="text-muted-foreground mt-2 text-sm text-pretty">{gateway.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="border-t">
    <div class="text-muted-foreground mx-auto flex max-w-5xl flex-col items-start justify-between gap-4 px-6 py-8 text-sm md:flex-row md:items-center md:gap-8">
      <p>Bias is MIT licensed and built by <a href={trackedUrl(NOTRA_URL)} target="_blank" rel="noopener" class="text-foreground hover:underline">Notra</a>. Every company, outlet, party and person on this page is fictional.</p>
      <div class="flex shrink-0 gap-6">
        <a href={REPO_URL} class="hover:text-foreground">Server source</a>
        <a href={SITE_REPO_URL} class="hover:text-foreground">Site source</a>
      </div>
    </div>
  </footer>
</Layout>
